unmanaged implementation in class zbp_i_salesorder unique;
strict ( 2 );

define behavior for ZI_SalesOrder alias SalesOrder
lock master
authorization master ( none )
{
  create;
  update;
  delete;
  association _Item { create; }
  action submit result [1] $self;

  field ( readonly ) SalesOrderId, CreatedAt, LastChangedAt, TotalAmount, Status;

  mapping for zso_header
  {
    SalesOrderId = sales_order_id;
    CustomerId = customer_id;
    OrderDate = order_date;
    Status = status;
    CurrencyCode = currency_code;
    TotalAmount = total_amount;
    CreatedAt = created_at;
    LastChangedAt = last_changed_at;
  }
}

define behavior for ZI_SalesOrderItem alias SalesOrderItem
lock dependent by _SalesOrder
authorization dependent by _SalesOrder
{
  update;
  delete;

  field ( readonly ) SalesOrderId, ItemId, CreatedAt, LastChangedAt;

  mapping for zso_item
  {
    SalesOrderId = sales_order_id;
    ItemId = item_id;
    ProductId = product_id;
    Quantity = quantity;
    UnitPrice = unit_price;
    CurrencyCode = currency_code;
    CreatedAt = created_at;
    LastChangedAt = last_changed_at;
  }
}
